<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/hero_background"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/button_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_secondary_background"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="‹ 返回"
            android:textColor="#D7E7F8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/usage_room_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:text="寝室 · 近 90 天用电明细"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="照明与空调分表汇总 · 每日总额与原始记录"
            android:textColor="#C9DAED"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tab_daily"
            style="@style/HpuButton.Primary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginRight="5dp"
            android:layout_weight="1"
            android:text="每日汇总" />

        <Button
            android:id="@+id/tab_records"
            style="@style/HpuButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:text="原始记录" />
    </LinearLayout>

    <TextView
        android:id="@+id/usage_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/card_background"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="4dp"
        android:padding="14dp"
        android:text="近 90 天汇总"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/usage_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="9dp"
        android:layout_marginRight="18dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/usage_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="18dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/usage_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingTop="4dp"
            android:paddingBottom="14dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/usage_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="28dp"
            android:text="暂无明细记录"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
