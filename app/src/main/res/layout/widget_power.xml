<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_icon_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="⚡"
            android:textColor="#0B1F3A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_room"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="未选择寝室"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/widget_refresh_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="40dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:text="刷新"
            android:textColor="@color/widget_text"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="照明余额"
                android:textColor="@color/widget_muted"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/widget_lighting"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="-- 度"
                android:textColor="@color/yellow"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="11dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="剩余电量"
                android:textColor="@color/widget_muted"
                android:textSize="7sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="空调余额"
                android:textColor="@color/widget_muted"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/widget_air"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="-- 度"
                android:textColor="@color/accent_light"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="11dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="剩余电量"
                android:textColor="@color/widget_muted"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_secondary_background"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_today"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="今日 -- 度 · ¥--"
            android:textColor="@color/widget_text"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_secondary_background"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="昨日"
                android:textColor="@color/widget_muted"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/widget_yesterday"
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="-- 元"
                android:textColor="@color/widget_text"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_secondary_background"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="近7日"
                android:textColor="@color/widget_muted"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/widget_week"
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="-- 元"
                android:textColor="@color/widget_text"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_secondary_background"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_latest_date"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="最新 --"
                android:textColor="@color/widget_muted"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/widget_latest"
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="-- 元"
                android:textColor="@color/widget_text"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="11dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="等待首次更新"
        android:textColor="@color/widget_muted"
        android:textSize="8sp" />
</LinearLayout>
